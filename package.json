{
  "name": "nestjs-workers",
  "version": "0.1.0",
  "description": "NestJS 12 + Bun + TypeScript 7 starter",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --hot run src/main.ts",
    "start:debug": "bun --inspect run src/main.ts",
    "start:prod": "bun run dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "bunx prettier --write \"src/**/*.ts\"",
    "lint": "bunx eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "bun-types": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
